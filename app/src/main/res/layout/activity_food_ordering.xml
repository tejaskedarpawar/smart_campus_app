<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/purple_700"
            android:padding="16dp"
            android:paddingTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍕 Online Food Ordering"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P3: Event Handlers Demo"
                android:textSize="12sp"
                android:textColor="#CCFFFFFF"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etFoodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Your Name"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                <EditText
                    android:id="@+id/etDeliveryAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter Delivery Address"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Food Items:"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginBottom="8dp"/>

                <CheckBox android:id="@+id/cbPizza" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="🍕  Pizza"
                    android:textSize="15sp" android:buttonTint="@color/purple_700"/>

                <CheckBox android:id="@+id/cbBurger" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="🍔  Burger"
                    android:textSize="15sp" android:buttonTint="@color/purple_700"/>

                <CheckBox android:id="@+id/cbPasta" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="🍝  Pasta"
                    android:textSize="15sp" android:buttonTint="@color/purple_700"/>

                <CheckBox android:id="@+id/cbSalad" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="🥗  Salad"
                    android:textSize="15sp" android:buttonTint="@color/purple_700"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method:"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"/>

                <RadioGroup
                    android:id="@+id/rgPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <RadioButton android:id="@+id/rbOnline" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Online"
                        android:buttonTint="@color/purple_700" android:layout_marginEnd="16dp"/>
                    <RadioButton android:id="@+id/rbCash" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Cash"
                        android:buttonTint="@color/purple_700" android:layout_marginEnd="16dp"/>
                    <RadioButton android:id="@+id/rbUPI" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="UPI"
                        android:buttonTint="@color/purple_700"/>
                </RadioGroup>

                <Button
                    android:id="@+id/btnSubmitOrder"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="SUBMIT ORDER"
                    android:textSize="16sp"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Button is disabled until name, address and food item are selected"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:layout_gravity="center"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
