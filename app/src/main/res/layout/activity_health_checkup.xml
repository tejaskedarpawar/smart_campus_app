<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F4F6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Health Checkup"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@color/purple_700"
        android:padding="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="P2: Same form shown in 3 different layouts"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:background="@color/purple_500"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"/>

    <TabHost
        android:id="@+id/tabHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TabWidget
                android:id="@android:id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <FrameLayout
                android:id="@android:id/tabcontent"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- TAB 1: Nested LinearLayout -->
                <ScrollView
                    android:id="@+id/tabLinear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Health Checkup" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/purple_700"
                            android:layout_gravity="center" android:layout_marginBottom="16dp"/>

                        <EditText android:id="@+id/etNameLinear" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Enter Name"
                            android:layout_marginBottom="8dp" android:padding="10dp"
                            android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <EditText android:id="@+id/etAgeLinear" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Enter Age"
                            android:inputType="number" android:layout_marginBottom="8dp"
                            android:padding="10dp" android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <!-- Nested LinearLayout for Blood Group -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:background="@drawable/input_background" android:padding="10dp"
                            android:layout_marginBottom="8dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Blood Group:" android:textSize="14sp" android:textColor="#374151"/>

                            <RadioGroup android:id="@+id/rgBloodLinear" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:orientation="horizontal">
                                <RadioButton android:id="@+id/rbALinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="A"/>
                                <RadioButton android:id="@+id/rbBLinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="B"/>
                                <RadioButton android:id="@+id/rbABLinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="AB"/>
                                <RadioButton android:id="@+id/rbOLinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="O"/>
                            </RadioGroup>
                        </LinearLayout>

                        <!-- Nested LinearLayout for Gender -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="vertical"
                            android:background="@drawable/input_background" android:padding="10dp"
                            android:layout_marginBottom="8dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Gender:" android:textSize="14sp" android:textColor="#374151"/>

                            <RadioGroup android:id="@+id/rgGenderLinear" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:orientation="horizontal">
                                <RadioButton android:id="@+id/rbMaleLinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Male"/>
                                <RadioButton android:id="@+id/rbFemaleLinear" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" android:text="Female"/>
                            </RadioGroup>
                        </LinearLayout>

                        <EditText android:id="@+id/etMobileLinear" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Mobile No."
                            android:inputType="phone" android:maxLength="10"
                            android:layout_marginBottom="8dp" android:padding="10dp"
                            android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <EditText android:id="@+id/etAddressLinear" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Address"
                            android:minLines="2" android:layout_marginBottom="16dp"
                            android:padding="10dp" android:background="@drawable/input_background"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <!-- Nested LinearLayout for buttons -->
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:orientation="horizontal"
                            android:gravity="center" android:weightSum="2">

                            <Button android:id="@+id/btnSubmitLinear" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Submit" android:backgroundTint="@color/purple_700"
                                android:layout_marginEnd="8dp"/>

                            <Button android:id="@+id/btnResetLinear" android:layout_width="0dp"
                                android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="Reset" android:backgroundTint="#9CA3AF"/>
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- TAB 2: RelativeLayout -->
                <ScrollView
                    android:id="@+id/tabRelative"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvTitleRelative"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Health Checkup" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/purple_700"
                            android:layout_centerHorizontal="true"/>

                        <EditText android:id="@+id/etNameRelative"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Enter Name" android:padding="10dp"
                            android:background="@drawable/input_background"
                            android:layout_below="@id/tvTitleRelative" android:layout_marginTop="16dp"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <EditText android:id="@+id/etAgeRelative"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Enter Age" android:inputType="number" android:padding="10dp"
                            android:background="@drawable/input_background"
                            android:layout_below="@id/etNameRelative" android:layout_marginTop="8dp"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <TextView android:id="@+id/tvBloodRelative"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Blood Group:" android:textSize="14sp"
                            android:layout_below="@id/etAgeRelative" android:layout_marginTop="12dp"/>

                        <RadioGroup android:id="@+id/rgBloodRelative"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_below="@id/tvBloodRelative" android:layout_marginTop="4dp">
                            <RadioButton android:id="@+id/rbARelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="A"/>
                            <RadioButton android:id="@+id/rbBRelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="B"/>
                            <RadioButton android:id="@+id/rbABRelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="AB"/>
                            <RadioButton android:id="@+id/rbORelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="O"/>
                        </RadioGroup>

                        <TextView android:id="@+id/tvGenderRelative"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gender:" android:textSize="14sp"
                            android:layout_below="@id/rgBloodRelative" android:layout_marginTop="8dp"/>

                        <RadioGroup android:id="@+id/rgGenderRelative"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_below="@id/tvGenderRelative" android:layout_marginTop="4dp">
                            <RadioButton android:id="@+id/rbMaleRelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Male"/>
                            <RadioButton android:id="@+id/rbFemaleRelative" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Female"/>
                        </RadioGroup>

                        <EditText android:id="@+id/etMobileRelative"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="Mobile No." android:inputType="phone" android:maxLength="10"
                            android:padding="10dp" android:background="@drawable/input_background"
                            android:layout_below="@id/rgGenderRelative" android:layout_marginTop="8dp"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <Button android:id="@+id/btnSubmitRelative"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Submit" android:backgroundTint="@color/purple_700"
                            android:layout_below="@id/etMobileRelative"
                            android:layout_alignParentEnd="false"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="16dp"/>

                        <Button android:id="@+id/btnResetRelative"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Reset" android:backgroundTint="#9CA3AF"
                            android:layout_below="@id/btnSubmitRelative"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="8dp"/>

                    </RelativeLayout>
                </ScrollView>

                <!-- TAB 3: ConstraintLayout -->
                <ScrollView
                    android:id="@+id/tabConstraint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView android:id="@+id/tvTitleConstraint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Health Checkup" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="@color/purple_700"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <EditText android:id="@+id/etNameConstraint"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:hint="Enter Name" android:padding="10dp"
                            android:background="@drawable/input_background"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/tvTitleConstraint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <EditText android:id="@+id/etAgeConstraint"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:hint="Enter Age" android:inputType="number" android:padding="10dp"
                            android:background="@drawable/input_background"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/etNameConstraint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <TextView android:id="@+id/tvBloodConstraint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Blood Group:" android:textSize="14sp"
                            android:layout_marginTop="12dp"
                            app:layout_constraintTop_toBottomOf="@id/etAgeConstraint"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <RadioGroup android:id="@+id/rgBloodConstraint"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginTop="4dp"
                            app:layout_constraintTop_toBottomOf="@id/tvBloodConstraint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <RadioButton android:id="@+id/rbAConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="A"/>
                            <RadioButton android:id="@+id/rbBConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="B"/>
                            <RadioButton android:id="@+id/rbABConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="AB"/>
                            <RadioButton android:id="@+id/rbOConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="O"/>
                        </RadioGroup>

                        <TextView android:id="@+id/tvGenderConstraint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Gender:" android:textSize="14sp" android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/rgBloodConstraint"
                            app:layout_constraintStart_toStartOf="parent"/>

                        <RadioGroup android:id="@+id/rgGenderConstraint"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginTop="4dp"
                            app:layout_constraintTop_toBottomOf="@id/tvGenderConstraint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">
                            <RadioButton android:id="@+id/rbMaleConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Male"/>
                            <RadioButton android:id="@+id/rbFemaleConstraint" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="Female"/>
                        </RadioGroup>

                        <EditText android:id="@+id/etMobileConstraint"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:hint="Mobile No." android:inputType="phone" android:maxLength="10"
                            android:padding="10dp" android:background="@drawable/input_background"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/rgGenderConstraint"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                android:textColor="#000000"
                android:textColorHint="#9CA3AF"/>

                        <Button android:id="@+id/btnSubmitConstraint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Submit" android:backgroundTint="@color/purple_700"
                            android:layout_marginTop="16dp" android:layout_marginEnd="8dp"
                            app:layout_constraintTop_toBottomOf="@id/etMobileConstraint"
                            app:layout_constraintEnd_toStartOf="@id/btnResetConstraint"/>

                        <Button android:id="@+id/btnResetConstraint"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Reset" android:backgroundTint="#9CA3AF"
                            android:layout_marginTop="16dp"
                            app:layout_constraintTop_toBottomOf="@id/etMobileConstraint"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </ScrollView>

            </FrameLayout>
        </LinearLayout>
    </TabHost>
</LinearLayout>
